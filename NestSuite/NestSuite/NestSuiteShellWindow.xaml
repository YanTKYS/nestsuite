<Window x:Class="NestSuite.NestSuiteShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NestSuite"
        xmlns:svc="clr-namespace:NestSuite.Services"
        xmlns:views="clr-namespace:NestSuite.Views"
        xmlns:chatnest="clr-namespace:NestSuite.ChatNest"
        xmlns:ideanest="clr-namespace:NestSuite.IdeaNest.Views"
        xmlns:tempnest="clr-namespace:NestSuite.TempNest"
        xmlns:plaintext="clr-namespace:NestSuite.PlainText"
        Title="NestSuite"
        Height="720" Width="1280"
        MinHeight="500" MinWidth="870"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <!-- Ctrl+S で SaveActiveTab() を実行する。ApplicationCommands.Save は Ctrl+S ジェスチャを内包する -->
        <CommandBinding Command="ApplicationCommands.Save" Executed="CommandSave_Executed"/>
        <!-- Ctrl+Shift+S ですべて保存を実行する -->
        <CommandBinding Command="{x:Static local:NestSuiteShellWindow.SaveAllCommand}" Executed="CommandSaveAll_Executed"/>
        <!-- Ctrl+Shift+F で Shell 横断検索パネルを開閉する -->
        <CommandBinding Command="{x:Static local:NestSuiteShellWindow.CrossSearchCommand}" Executed="CommandCrossSearch_Executed"/>
    </Window.CommandBindings>
    <!-- ルートに Background 未指定だと、子要素で覆われない隙間が
         Window既定の白色で透けて見える（ダークテーマ時に右ペイン折り畳みボタン周辺が
         白いバーになる不具合の原因）。AppBg を明示指定して背景を統一する。 -->
    <DockPanel Background="{DynamicResource AppBg}">
        <!-- ファイルメニュー: 新規/開くはツール横断、保存系は選択中タブの WorkspaceKind に応じて処理する -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)"
                      AutomationProperties.AutomationId="Shell.FileMenu"
                      AutomationProperties.Name="Shell.FileMenu">
                <!-- 各 Nest の新規作成導線はここ（ファイル > 新規作成）とタブバーの
                     ＋ ボタンへ集約する。ツールメニューからは各 Nest の起動・新規作成項目を削除した。 -->
                <MenuItem Header="新規作成(_N)"
                          AutomationProperties.AutomationId="Shell.NewMenu"
                          AutomationProperties.Name="Shell.NewMenu">
                    <MenuItem Header="新規 NoteNest — ノートをプロジェクト単位で管理(_N)"
                              AutomationProperties.AutomationId="Shell.MenuNewNoteNest"
                              AutomationProperties.Name="Shell.MenuNewNoteNest"
                              Click="MenuNewNoteNest_Click"/>
                    <MenuItem Header="新規 IdeaNest — アイデアをカード形式で整理(_I)"
                              AutomationProperties.AutomationId="Shell.MenuNewIdeaNest"
                              AutomationProperties.Name="Shell.MenuNewIdeaNest"
                              Click="MenuNewIdeaNest_Click"/>
                    <MenuItem Header="新規 ChatNest — チャット形式でブレスト記録(_C)"
                              AutomationProperties.AutomationId="Shell.MenuNewChatNest"
                              AutomationProperties.Name="Shell.MenuNewChatNest"
                              Click="MenuNewChatNest_Click"/>
                    <!-- 通常の .txt を扱う最小プレーンテキスト Workspace。新しい Nest ではない。 -->
                    <MenuItem Header="新規 テキスト — シンプルなプレーンテキスト編集(_T)"
                              AutomationProperties.AutomationId="Shell.MenuNewText"
                              AutomationProperties.Name="Shell.MenuNewText"
                              Click="MenuNewText_Click"/>
                </MenuItem>
                <MenuItem Header="開く(_O)..." Click="MenuOpen_Click"/>
                <MenuItem x:Name="RecentFilesMenu" Header="最近使ったファイル(_R)">
                    <MenuItem Header="（履歴なし）" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <!-- Save / SaveAll は Ctrl+S / Ctrl+Shift+S の CommandBinding.Executed に
                     引き続き委譲しつつ、MenuItem 自体は Click ハンドラへ切り替えた。Command バインドのままだと
                     WPF の CanExecute 再照会で IsEnabled を手動制御できない（毎回上書きされる）ため。
                     ショートカットキーの動作・保存ロジックは変更していない。 -->
                <MenuItem x:Name="SaveMenuItem" Header="上書き保存(_S)"
                          Click="MenuSave_Click" InputGestureText="Ctrl+S"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem x:Name="SaveAllMenuItem" Header="すべて保存(_A)"
                          Click="MenuSaveAll_Click" InputGestureText="Ctrl+Shift+S"
                          ToolTipService.ShowOnDisabled="True"/>
                <MenuItem x:Name="SaveAsMenuItem" Header="名前を付けて保存(_V)..." Click="MenuSaveAs_Click"
                          ToolTipService.ShowOnDisabled="True"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="MenuExit_Click"/>
            </MenuItem>
            <!-- ツールメニューは各 Nest の起動・新規作成導線ではなく、Shell の補助機能
                 （横断検索、将来的な横断タスクビュー・関連管理・振り返りダッシュボードなど）を置く場所とする。
                 各 Nest の新規作成は ファイル > 新規作成 とタブバーの ＋ ボタンに集約した。 -->
            <MenuItem Header="ツール(_T)"
                      AutomationProperties.AutomationId="Shell.ToolMenu"
                      AutomationProperties.Name="Shell.ToolMenu">
                <!-- Shell横断検索（開いているタブのみ対象。新規 Workspace ではなく Shell 機能）。
                     「表示切替」ではなく「作業補助ツール」のため表示メニューではなくツールメニューに置く。 -->
                <MenuItem Header="横断検索(_S)"
                          AutomationProperties.AutomationId="Shell.CrossSearchMenuItem"
                          AutomationProperties.Name="Shell.CrossSearchMenuItem"
                          Command="{x:Static local:NestSuiteShellWindow.CrossSearchCommand}"
                          InputGestureText="Ctrl+Shift+F"/>
                <Separator/>
                <MenuItem Header="デバイス移行パックをエクスポート(_E)..."
                          AutomationProperties.AutomationId="Shell.ExportMigrationPackMenuItem"
                          AutomationProperties.Name="Shell.ExportMigrationPackMenuItem"
                          Click="MenuExportMigrationPack_Click"/>
                <MenuItem Header="デバイス移行パックをインポート(_I)..."
                          AutomationProperties.AutomationId="Shell.ImportMigrationPackMenuItem"
                          AutomationProperties.Name="Shell.ImportMigrationPackMenuItem"
                          Click="MenuImportMigrationPack_Click"/>
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="テーマ(_T)">
                    <MenuItem x:Name="ThemeLightMenuItem"
                              Header="Light"
                              IsCheckable="True"
                              Click="MenuThemeLight_Click"/>
                    <MenuItem x:Name="ThemeDarkMenuItem"
                              Header="Dark"
                              IsCheckable="True"
                              Click="MenuThemeDark_Click"/>
                </MenuItem>
                <!-- NoteNest / IdeaNest / ChatNest / TempNest 共通の本文・編集領域フォント種類。
                     NoteNest を開いていなくても変更できるよう、Workspace 内ではなくメニューバーに置く。 -->
                <MenuItem Header="本文フォント(_F)"
                          AutomationProperties.AutomationId="Shell.WorkspaceFontMenu"
                          AutomationProperties.Name="Shell.WorkspaceFontMenu">
                    <MenuItem x:Name="WorkspaceFontYuGothicUiMenuItem"
                              Header="Yu Gothic UI"
                              Tag="Yu Gothic UI"
                              IsCheckable="True"
                              Click="MenuWorkspaceFont_Click"/>
                    <MenuItem x:Name="WorkspaceFontMeiryoUiMenuItem"
                              Header="Meiryo UI"
                              Tag="Meiryo UI"
                              IsCheckable="True"
                              Click="MenuWorkspaceFont_Click"/>
                    <MenuItem x:Name="WorkspaceFontMsGothicMenuItem"
                              Header="MS Gothic"
                              Tag="MS Gothic"
                              IsCheckable="True"
                              Click="MenuWorkspaceFont_Click"/>
                    <MenuItem x:Name="WorkspaceFontBizUdGothicMenuItem"
                              Header="BIZ UDGothic"
                              Tag="BIZ UDGothic"
                              IsCheckable="True"
                              Click="MenuWorkspaceFont_Click"/>
                    <MenuItem x:Name="WorkspaceFontBizUdMinchoMenuItem"
                              Header="BIZ UDMincho"
                              Tag="BIZ UDMincho"
                              IsCheckable="True"
                              Click="MenuWorkspaceFont_Click"/>
                    <MenuItem x:Name="WorkspaceFontUdDigiKyokashoMenuItem"
                              Header="UD Digi Kyokasho N-R"
                              Tag="UD Digi Kyokasho N-R"
                              IsCheckable="True"
                              Click="MenuWorkspaceFont_Click"/>
                    <MenuItem x:Name="WorkspaceFontConsolasMenuItem"
                              Header="Consolas"
                              Tag="Consolas"
                              IsCheckable="True"
                              Click="MenuWorkspaceFont_Click"/>
                </MenuItem>
                <!-- NoteNest 左ペインのノート一覧表示順。NoteNest を開いていなくても変更できるよう
                     本文フォントと同様にメニューバーへ置く。保存データの並び順は変更しない。 -->
                <MenuItem Header="ノートの並び順(_O)"
                          AutomationProperties.AutomationId="Shell.NoteSortModeMenu"
                          AutomationProperties.Name="Shell.NoteSortModeMenu">
                    <MenuItem x:Name="NoteSortModeCreatedMenuItem"
                              Header="作成順"
                              Tag="Created"
                              IsCheckable="True"
                              AutomationProperties.AutomationId="NoteNest.SortMode.Created"
                              AutomationProperties.Name="NoteNest.SortMode.Created"
                              Click="MenuNoteSortMode_Click"/>
                    <MenuItem x:Name="NoteSortModeUpdatedMenuItem"
                              Header="更新日順"
                              Tag="Updated"
                              IsCheckable="True"
                              AutomationProperties.AutomationId="NoteNest.SortMode.Updated"
                              AutomationProperties.Name="NoteNest.SortMode.Updated"
                              Click="MenuNoteSortMode_Click"/>
                    <MenuItem x:Name="NoteSortModeTitleMenuItem"
                              Header="タイトル順"
                              Tag="Title"
                              IsCheckable="True"
                              AutomationProperties.AutomationId="NoteNest.SortMode.Title"
                              AutomationProperties.Name="NoteNest.SortMode.Title"
                              Click="MenuNoteSortMode_Click"/>
                </MenuItem>
                <!-- NoteNest 本文エディタのワードラップ切替。NoteNest を開いていなくても
                     変更できるよう、本文フォント・ノートの並び順と同様にメニューバーへ置く。
                     保存データ（本文・schema）は変更しない、表示専用の UI 設定。 -->
                <MenuItem x:Name="NoteNestWordWrapMenuItem"
                          Header="テキストを折り返す(_W)"
                          IsCheckable="True"
                          AutomationProperties.AutomationId="Shell.NoteNestWordWrapMenuItem"
                          AutomationProperties.Name="Shell.NoteNestWordWrapMenuItem"
                          Click="MenuNoteNestWordWrap_Click"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <!-- 常時有効なヘルプ項目は「無効理由」ではなく短い説明のみを付ける -->
                <MenuItem Header="キーボードショートカット(_K)"
                          AutomationProperties.AutomationId="Shell.KeyboardShortcutsMenuItem"
                          AutomationProperties.Name="Shell.KeyboardShortcutsMenuItem"
                          ToolTip="{x:Static svc:ShellCommandTooltipProvider.KeyboardShortcutsTooltip}"
                          Click="MenuKeyboardShortcuts_Click"/>
                <MenuItem Header="バックアップ復元ガイド(_B)"
                          AutomationProperties.AutomationId="Shell.BackupRestoreGuideMenuItem"
                          AutomationProperties.Name="Shell.BackupRestoreGuideMenuItem"
                          ToolTip="{x:Static svc:ShellCommandTooltipProvider.BackupRestoreGuideTooltip}"
                          Click="MenuBackupRestoreGuide_Click"/>
                <!-- 利用者が任意に開く読み取り専用の現在地サマリー。常設ステータスバー表示ではない。 -->
                <MenuItem Header="現在の状態(_S)"
                          AutomationProperties.AutomationId="Shell.StateSummaryMenuItem"
                          AutomationProperties.Name="Shell.StateSummaryMenuItem"
                          ToolTip="{x:Static svc:ShellCommandTooltipProvider.StateSummaryTooltip}"
                          Click="MenuShowStateSummary_Click"/>
                <Separator/>
                <MenuItem Header="ファイル関連付けの設定(_A)..."
                          ToolTip="{x:Static svc:ShellCommandTooltipProvider.FileAssociationTooltip}"
                          Click="MenuFileAssociation_Click"/>
                <Separator/>
                <MenuItem Header="NestSuite について" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- NestSuite ステータスバー（プロジェクト名・未保存・選択ツール動的表示） -->
        <Border DockPanel.Dock="Bottom" Height="22"
                Background="{DynamicResource StatusBarBg}"
                BorderBrush="{DynamicResource PaneBorder}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <!-- アクティブタブ（_selectedTab）を基準に RefreshWorkspaceStatus で更新する。
                     Window.DataContext（NoteNest 固有）への直接 Binding は行わない -->
                <TextBlock x:Name="ShellStatusFileText"
                           AutomationProperties.AutomationId="Shell.StatusBar"
                           AutomationProperties.Name="Shell.StatusBar"
                           FontSize="11" Foreground="{DynamicResource MutedFg}"/>
                <TextBlock x:Name="ShellStatusUnsavedText"
                           FontSize="11" Foreground="{DynamicResource UnsavedBrush}"/>
                <TextBlock x:Name="NestSuiteModeSuffix"
                           Text="  /  NoteNest"
                           FontSize="11" Foreground="{DynamicResource MutedFg}"/>
                <TextBlock x:Name="WorkspaceStatusText"
                           FontSize="11" Foreground="{DynamicResource MutedFg}"/>
            </StackPanel>
        </Border>

        <!-- Shell横断検索パネル（開いているタブのみが対象。表示状態・検索語・結果はどこにも永続化しない） -->
        <Border x:Name="CrossSearchPanel"
                DockPanel.Dock="Right"
                Width="300"
                Visibility="Collapsed"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource PaneBorder}"
                BorderThickness="1,0,0,0">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <!-- DockPanel ではなく Grid で組む。DockPanel の LastChildFill は最後の子である
                         × ボタンの Dock="Right" を無視して残り領域いっぱいに広げてしまい、閉じるボタンが
                         中央寄りに見えるため。タイトル列（*）と閉じるボタン列（Auto）を明示的に分離する。 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="横断検索" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="×" FontSize="12"
                                Width="22" Height="22"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="横断検索パネルを閉じる（Escでも閉じられます）"
                                AutomationProperties.Name="横断検索を閉じる"
                                Click="CrossSearchCloseButton_Click"/>
                    </Grid>
                    <TextBox x:Name="CrossSearchBox"
                             AutomationProperties.AutomationId="Shell.CrossSearchBox"
                             AutomationProperties.Name="Shell.CrossSearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Padding="4"/>
                    <!-- 既定OFF・永続化しない。ON時だけ現在開いていない
                         recent files上位5件も検索対象に含める。 -->
                    <CheckBox x:Name="CrossSearchIncludeRecentFilesCheckBox"
                              Content="最近のファイルも検索"
                              IsChecked="{Binding IncludeRecentFiles}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,6,0,0"
                              ToolTip="開いていない最近使ったファイルも検索対象に含めます"
                              AutomationProperties.AutomationId="Shell.CrossSearch.IncludeRecentFiles"
                              AutomationProperties.Name="最近のファイルも検索。開いていない最近使ったファイルも検索対象に含めます"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedFg}"
                               FontSize="11" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 「開いているファイル」グループ。0件のときは見出しごと表示しない。 -->
                        <TextBlock Text="開いているファイル" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,2"
                                   Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"/>
                        <ListBox x:Name="CrossSearchResultsList"
                                 AutomationProperties.AutomationId="Shell.CrossSearchResultsList"
                                 AutomationProperties.Name="Shell.CrossSearchResultsList"
                                 ItemsSource="{Binding Results}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
                                 SelectionChanged="CrossSearchResultsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding HeaderText}" FontSize="11"
                                                   Foreground="{DynamicResource MutedFg}"/>
                                        <TextBlock Text="{Binding PreviewText}" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 「最近使ったファイル」グループ（未オープンrecent files。ON時のみ）。 -->
                        <TextBlock Text="最近使ったファイル" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,8,0,2"
                                   Visibility="{Binding HasUnopenedResults, Converter={StaticResource BoolToVis}}"/>
                        <ListBox x:Name="CrossSearchUnopenedResultsList"
                                 AutomationProperties.AutomationId="Shell.CrossSearchUnopenedResultsList"
                                 AutomationProperties.Name="Shell.CrossSearchUnopenedResultsList"
                                 ItemsSource="{Binding UnopenedResults}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasUnopenedResults, Converter={StaticResource BoolToVis}}"
                                 SelectionChanged="CrossSearchResultsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5" ToolTip="{Binding FilePath}">
                                        <TextBlock Text="{Binding HeaderText}" FontSize="11"
                                                   Foreground="{DynamicResource MutedFg}"/>
                                        <TextBlock Text="{Binding PreviewText}" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- メインエリア: Workspace 領域（全幅。左ツール選択カラムは持たない） -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Height="Auto" + MinHeight="50" でタブ（32px）とスクロールバー（~17px）が重ならないよう確保 -->
                <RowDefinition Height="Auto"/>
                <!-- Workspace コンテンツ -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ファイル単位タブストリップ。ItemsSource は NestSuiteDocumentTab のコレクション -->
            <!-- DockPanel で「＋」ボタンを右端に配置する -->
            <Border Grid.Row="0"
                    MinHeight="50"
                    BorderBrush="{DynamicResource PaneBorder}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- 新規タブ追加ボタン。クリックで NoteNest/IdeaNest/ChatNest 選択メニューを表示 -->
                    <!-- IconButton スタイルを適用する（Foreground/hover 未指定だとダークテーマで白浮きするため） -->
                    <Button DockPanel.Dock="Right"
                            AutomationProperties.AutomationId="Shell.TabAddButton"
                            AutomationProperties.Name="新規タブを追加"
                            Content="＋"
                            Style="{StaticResource IconButton}"
                            FontSize="14"
                            Width="36"
                            VerticalAlignment="Stretch"
                            ToolTip="新規タブを追加"
                            Click="TabAddButton_Click">
                        <Button.ContextMenu>
                            <!-- ファイル > 新規作成 と同じ説明的表記を用いる -->
                            <ContextMenu>
                                <MenuItem Header="新規 NoteNest — ノートをプロジェクト単位で管理(_N)"
                                          AutomationProperties.AutomationId="Shell.TabAddMenuNoteNest"
                                          AutomationProperties.Name="Shell.TabAddMenuNoteNest"
                                          Click="MenuNewNoteNest_Click"/>
                                <MenuItem Header="新規 IdeaNest — アイデアをカード形式で整理(_I)"
                                          AutomationProperties.AutomationId="Shell.TabAddMenuIdeaNest"
                                          AutomationProperties.Name="Shell.TabAddMenuIdeaNest"
                                          Click="MenuNewIdeaNest_Click"/>
                                <MenuItem Header="新規 ChatNest — チャット形式でブレスト記録(_C)"
                                          AutomationProperties.AutomationId="Shell.TabAddMenuChatNest"
                                          AutomationProperties.Name="Shell.TabAddMenuChatNest"
                                          Click="MenuNewChatNest_Click"/>
                                <MenuItem Header="新規 テキスト — シンプルなプレーンテキスト編集(_T)"
                                          AutomationProperties.AutomationId="Shell.TabAddMenuText"
                                          AutomationProperties.Name="Shell.TabAddMenuText"
                                          Click="MenuNewText_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- タブ一覧ボタン。クリックで開いているタブをドロップダウン一覧表示 -->
                    <!-- IconButton スタイルを適用する（Foreground/hover 未指定だとダークテーマで白浮きするため） -->
                    <Button DockPanel.Dock="Right"
                            AutomationProperties.AutomationId="Shell.TabListButton"
                            AutomationProperties.Name="タブ一覧を開く"
                            Content="▾"
                            Style="{StaticResource IconButton}"
                            FontSize="12"
                            Width="28"
                            VerticalAlignment="Stretch"
                            ToolTip="タブ一覧"
                            Click="TabListButton_Click"/>
                    <ListBox x:Name="TabStrip"
                             AutomationProperties.AutomationId="Shell.TabStrip"
                             AutomationProperties.Name="Shell.TabStrip"
                             BorderThickness="0"
                             Background="{DynamicResource GroupHeaderBg}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             SelectionChanged="TabStrip_SelectionChanged"
                             PreviewMouseLeftButtonDown="TabStrip_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TabStrip_PreviewMouseMove"
                             PreviewMouseDown="TabStrip_PreviewMouseButtonDown"
                             DragOver="TabStrip_DragOver"
                             DragLeave="TabStrip_DragLeave"
                             Drop="TabStrip_Drop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <!-- Padding="0" / Stretch でアクセント帯を ListBoxItem 全幅に描画 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding TabAutomationId}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding TabAutomationId}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- ツールチップにツール種別・ファイルパス・保存状態を表示 -->
                                <!-- 上部 3px の Workspace 種別カラーアクセント -->
                                <!-- 右クリックコンテキストメニュー -->
                                <Grid ToolTip="{Binding TooltipText}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <!-- 無効な項目は隠さず、無効理由をツールチップで示す
                                                 （例: Temp タブでは「Temp タブはピン留めできません」）。
                                                 そのためピン留め項目の表示条件は PinActionVisible（!IsPinned）とし、
                                                 有効・無効は IsEnabled=CanPin で表す。 -->
                                            <MenuItem Header="このタブを閉じる(_C)"
                                                      IsEnabled="{Binding CanClose}"
                                                      ToolTip="{Binding CloseMenuTooltip}"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      Click="TabContextClose_Click"/>
                                            <Separator/>
                                            <MenuItem Header="ピン留め(_P)"
                                                      Visibility="{Binding PinActionVisible, Converter={StaticResource BoolToVis}}"
                                                      IsEnabled="{Binding CanPin}"
                                                      ToolTip="{Binding PinMenuTooltip}"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      Click="TabContextPin_Click"/>
                                            <MenuItem Header="ピン留めを解除(_U)"
                                                      Visibility="{Binding ShowUnpinMenuItem, Converter={StaticResource BoolToVis}}"
                                                      ToolTip="{Binding UnpinMenuTooltip}"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      Click="TabContextUnpin_Click"/>
                                            <!-- NoteNest 未分離タブのみ別ウィンドウ表示を提供する -->
                                            <MenuItem Header="別ウィンドウで表示(_D)"
                                                      Visibility="{Binding IsDetachable, Converter={StaticResource BoolToVis}}"
                                                      Click="TabContextDetach_Click"/>
                                            <!-- 分離中タブはシェルへ戻す操作を提供する -->
                                            <MenuItem Header="このタブへ戻す(_B)"
                                                      Visibility="{Binding IsDetached, Converter={StaticResource BoolToVis}}"
                                                      Click="TabContextReturnDetached_Click"/>
                                            <Separator/>
                                            <MenuItem Header="他のタブを閉じる(_O)"   Click="TabContextCloseOthers_Click"/>
                                            <MenuItem Header="右側のタブを閉じる(_R)" Click="TabContextCloseRight_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{Binding WorkspaceKind, Converter={StaticResource KindToAccent}}"/>
                                    <!-- タブラベル・未保存マーク・閉じるボタン -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding TabHeaderText}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <!-- 未保存マーク -->
                                        <TextBlock Text="●" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource UnsavedBrush}"
                                                   Margin="4,0,0,0"
                                                   Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                                        <!-- タブ閉じるボタン。Tag に自身のタブモデルをバインドして渡す -->
                                        <Button Content="×" FontSize="10"
                                                Margin="6,0,0,0" Padding="3,1"
                                                VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="このタブを閉じる"
                                                AutomationProperties.Name="このタブを閉じる"
                                                Tag="{Binding}"
                                                Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                                Click="TabClose_Click"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Workspace コンテンツ（選択タブに対応する Workspace を表示） -->
            <Grid Grid.Row="1">
                <!-- 既定は Visibility="Collapsed" とし、表示は ActivateTab が制御する。
                     起動時にタブ未選択の瞬間 NoteNest Workspace が見えるちらつきを防ぐため。 -->
                <views:NoteNestWorkspaceView x:Name="WorkspaceView"
                                             AutomationProperties.AutomationId="Shell.NoteNestWorkspace"
                                             AutomationProperties.Name="Shell.NoteNestWorkspace"
                                             Visibility="Collapsed"/>
                <!-- ChatNest 統合検証用 Workspace（ChatNest タブ選択時に表示） -->
                <chatnest:ChatNestWorkspaceView x:Name="ChatWorkspaceView"
                                                AutomationProperties.AutomationId="Shell.ChatNestWorkspace"
                                                AutomationProperties.Name="Shell.ChatNestWorkspace"
                                                Visibility="Collapsed"/>
                <!-- IdeaNest 統合検証用 Workspace（IdeaNest タブ選択時に表示） -->
                <ideanest:IdeaNestWorkspaceView x:Name="IdeaNestWorkspaceView"
                                                AutomationProperties.AutomationId="Shell.IdeaNestWorkspace"
                                                AutomationProperties.Name="Shell.IdeaNestWorkspace"
                                                ShowMenu="False" Visibility="Collapsed"/>
                <!-- TempNest 固定タブ Workspace（ファイル型でない内部 JSON 管理の一時メモ） -->
                <tempnest:TempNestWorkspaceView x:Name="TempNestWorkspaceView"
                                                AutomationProperties.AutomationId="Shell.TempNestWorkspace"
                                                AutomationProperties.Name="Shell.TempNestWorkspace"
                                                Visibility="Collapsed"/>
                <!-- 通常の .txt を扱う最小プレーンテキスト Workspace（PlainText タブ選択時に表示） -->
                <plaintext:PlainTextWorkspaceView x:Name="PlainTextWorkspaceView"
                                                  AutomationProperties.AutomationId="Shell.PlainTextWorkspace"
                                                  AutomationProperties.Name="Shell.PlainTextWorkspace"
                                                  Visibility="Collapsed"/>
                <!-- 別ウィンドウ表示中の NoteNest タブ向けプレースホルダー（説明文と「このタブへ戻す」ボタン） -->
                <Grid x:Name="DetachedNoteNestPlaceholder" Visibility="Collapsed"
                      AutomationProperties.AutomationId="Shell.DetachedWorkspacePlaceholder"
                      AutomationProperties.Name="Shell.DetachedWorkspacePlaceholder"
                      Background="{DynamicResource SidebarBg}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource MutedFg}"
                                   Margin="0,0,0,16">
                            このWorkspaceは別ウィンドウで表示中です。<LineBreak/>
                            別ウィンドウを閉じるか、「このタブへ戻す」を押すと、このタブ内に戻ります。
                        </TextBlock>
                        <Button HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="Shell.ReturnDetachedWorkspaceButton"
                                AutomationProperties.Name="Shell.ReturnDetachedWorkspaceButton"
                                Content="このタブへ戻す"
                                FontSize="13"
                                Padding="16,6"
                                Click="ReturnDetachedButton_Click"/>
                    </StackPanel>
                </Grid>
                <!-- 未統合ツールタブ選択時のプレースホルダー -->
                <Border x:Name="UnintegratedPlaceholder" Visibility="Collapsed"
                        Background="{DynamicResource SidebarBg}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="24">
                        <TextBlock x:Name="PlaceholderTitle"
                                   FontSize="18" FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource MutedFg}"
                                   Margin="0,0,0,16"/>
                        <TextBlock x:Name="PlaceholderMessage"
                                   FontSize="13" TextAlignment="Center"
                                   Foreground="{DynamicResource SubtleFg}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
